# Experimental Android bring-up; apply after defconfig and sm8250.config.
# Mainline interfaces do not replace the stock Qualcomm vendor ABI.
CONFIG_LOCALVERSION="-pipa-a17-v0.1"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_ARM64_4K_PAGES=y
CONFIG_COMPAT=y
CONFIG_ANDROID_BINDER_IPC=y
